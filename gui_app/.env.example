# Operator console (gui_app) configuration.
# Copy to gui_app/.env and fill in real values.

# AWS
AWS_REGION=us-east-1
BUCKET=replace-me-customer-bucket

# Observability (optional)
CUSTOMER=acme-parts
# LOG_LEVEL=INFO
# METRICS_DISABLED=1

# Multi-tenancy (see TENANCY.md)
# Fallback tenant id used when a message arrives without one. Set this
# to the value you used for LEGACY_TENANT in the 002 SQL migration.
DEFAULT_TENANT_ID=acme-parts

# Working SQS queues used by the operator console
SEARCH_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/search_queue
PROC_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/proc_queue
TEST_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/test_queue

# S3 key prefixes (without trailing slash)
SEARCH_KEY=search_jobs
PROC_KEY=proc_jobs
TEST_KEY=test_jobs

# Microsoft SQL Server
DB_HOST=sql.internal.example.com
DB_PORT=1433
DB_USER=parts_app
DB_PASSWORD=replace-me

# OpenAI Batch API
OPENAI_API_KEY=sk-replace-me
