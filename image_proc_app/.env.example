# Image processing worker (image_proc_app) configuration.
# Copy to image_proc_app/.env on the worker host or inject via the container runtime.

# AWS
AWS_REGION=us-east-1
BUCKET=replace-me-customer-bucket
IMAGE_KEY=images

# Observability (optional)
CUSTOMER=acme-parts
# LOG_LEVEL=INFO
# METRICS_DISABLED=1

# Multi-tenancy (see TENANCY.md)
# Fallback tenant id used when an in-flight SQS message has no tenant_id.
# Required during a single-tenant → multi-tenant cutover.
DEFAULT_TENANT_ID=acme-parts

# SQS queue this worker drains
QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/proc_queue

# Microsoft SQL Server
DB_HOST=sql.internal.example.com
DB_PORT=1433
DB_USER=parts_app
DB_PASSWORD=replace-me

# HMAC secret used to derive final/<hash>.png filenames.
# Generate per deployment, e.g. `openssl rand -hex 32`. Never reuse.
HTML_SECRET=replace-me-with-a-32-byte-random-hex-string
